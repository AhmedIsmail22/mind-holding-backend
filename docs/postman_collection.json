{
  "info": {
    "name": "MIND Holding API",
    "description": "Phase 1 backend REST API. Base URL variable: {{base_url}} (e.g. http://localhost:8000). Public endpoints read {{locale}} via Accept-Language. Admin endpoints need {{admin_token}} (Sanctum bearer token from POST /api/v1/admin/auth/login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "locale", "value": "ar" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "Public",
      "item": []
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{base_url}}/api/v1/admin/auth/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@mindholding.net\",\n  \"password\": \"\"\n}"
                }
              }
            },
            {
              "name": "Logout",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/admin/auth/logout",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] }
              }
            },
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/auth/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] }
              }
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            {
              "name": "List users",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/users",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] }
              }
            },
            {
              "name": "Create user",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{base_url}}/api/v1/admin/users",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sales Person\",\n  \"email\": \"sales@mindholding.net\",\n  \"password\": \"password123\",\n  \"role\": \"Sales\"\n}"
                }
              }
            },
            {
              "name": "Show user",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/users/1",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] }
              }
            },
            {
              "name": "Update user",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{base_url}}/api/v1/admin/users/1",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sales Person\",\n  \"email\": \"sales@mindholding.net\",\n  \"role\": \"Content editor\"\n}"
                }
              }
            },
            {
              "name": "Delete user",
              "request": {
                "method": "DELETE",
                "url": "{{base_url}}/api/v1/admin/users/1",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}" }] }
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{admin_token}}" }]
      }
    }
  ]
}
